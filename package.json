{
  "name": "cs-fundamentals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An in-depth, visual introduction to computer science: every complexity bound derived, every structure shown running, and every failure mode named.",
  "homepage": "https://danielsousaoliveira.github.io/cs-fundamentals/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielsousaoliveira/cs-fundamentals.git"
  },
  "bugs": {
    "url": "https://github.com/danielsousaoliveira/cs-fundamentals/issues"
  },
  "author": "Daniel Oliveira",
  "license": "MIT",
  "keywords": [
    "computer-science",
    "data-structures",
    "algorithms",
    "system-design",
    "distributed-systems",
    "databases",
    "data-engineering",
    "ai-engineering",
    "software-architecture",
    "learning-resources"
  ],
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "prettier --check .",
    "lint:spine": "node --experimental-strip-types scripts/lint-spine.ts",
    "format": "prettier --write .",
    "nb2mdx": "node --experimental-strip-types scripts/nb2mdx.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "og:image": "node --experimental-strip-types scripts/make-og-image.ts",
    "readme:media": "pnpm build && node --experimental-strip-types scripts/capture-readme-media.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/react": "^6.0.2",
    "@astrojs/starlight": "^0.41.6",
    "astro": "^7.1.6",
    "katex": "^0.18.1",
    "motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "axe-core": "^4.12.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "rehype-mermaid": "^3.0.0",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
