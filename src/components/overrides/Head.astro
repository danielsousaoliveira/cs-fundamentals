---
import Default from '@astrojs/starlight/components/Head.astro';

/**
 * Adds the Open Graph image to Starlight's own head output.
 *
 * Starlight already emits `og:title`, `og:description`, `og:url` and
 * `og:locale` per page from frontmatter, so the only thing missing for a link
 * preview is the picture and the Twitter card type. Everything else here is
 * inherited by rendering `<Default />` first rather than replacing it.
 *
 * The URL must be absolute — crawlers do not resolve relative paths, so a bare
 * `/og.png` produces no image at all.
 *
 * And it must include the base path. `Astro.site` is the origin only
 * (`https://…github.io`), so resolving against it alone yields
 * `https://…github.io/og.png`, which 404s under a project-page deployment.
 * `BASE_URL` is what carries `/cs-fundamentals/`. This is the same base-path
 * trap that hand-written `/foo` hrefs fall into — it works in dev and breaks
 * only once deployed, which is why `e2e/site.spec.ts` asserts on it.
 */
const ogImage = new URL(`${import.meta.env.BASE_URL}og.png`, Astro.site ?? Astro.url)
  .href;
---

<Default><slot /></Default>

<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="CS Fundamentals" />

{
  /* `twitter:card` is already emitted by Starlight — adding it here too would
    duplicate the tag. Only the image needs supplying. */
}
<meta name="twitter:image" content={ogImage} />
