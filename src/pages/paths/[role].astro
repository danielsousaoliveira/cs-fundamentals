---
/**
 * One route, one page per role — same pattern as the section index pages.
 * Tagging a page with a role puts it here with no other edit.
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { ROLES, pagesForRole } from '../../lib/roles.ts';

export async function getStaticPaths() {
  return Promise.all(
    ROLES.map(async (role) => ({
      params: { role: role.slug },
      props: { role, pages: await pagesForRole(role.slug) },
    })),
  );
}

const { role, pages } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<StarlightPage
  frontmatter={{
    title: role.label,
    description: role.description,
    tableOfContents: false,
  }}
>
  <p>{role.description}</p>
  {
    pages.length === 0 ? (
      <p class="section-empty">No pages are tagged for this path yet.</p>
    ) : (
      <ul class="card-grid">
        {pages.map((page) => (
          <li>
            <a class="topic-card" href={`${base}${page.id}/`}>
              <span class="topic-card__title">{page.data.title}</span>
              {page.data.description && (
                <span class="topic-card__desc">{page.data.description}</span>
              )}
              <span class="topic-card__meta">
                <span>{page.data.difficulty}</span>
                {page.data.status !== 'complete' && <span>· {page.data.status}</span>}
              </span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</StarlightPage>
